{
  "name": "llm-schema-guardian",
  "version": "1.0.0",
  "description": "TypeScript auto-healing wrapper that enforces strict Zod JSON schemas on LLM outputs.",
  "main": "src/guardian.ts",
  "scripts": {
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:smoke": "vitest run tests/smoke",
    "typecheck": "tsc --strict --noEmit src/guardian.ts tests/unit/guardian.test.ts tests/smoke/guardian.smoke.test.ts"
  },
  "keywords": [
    "llm",
    "zod",
    "typescript",
    "json-schema",
    "auto-healing",
    "ai-engineering"
  ],
  "author": "Facundo Vergara",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
